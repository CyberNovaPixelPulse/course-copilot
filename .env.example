# Copy this file to .env.local and paste your keys.
# Never commit .env.local.

OPENAI_API_KEY=

# Signed usage cookies (optional; falls back to Stripe or OpenAI key).
USAGE_SECRET=

# Stripe Checkout. The NT$9 plan is converted to USD, JPY, KRW, or EUR from the selected language.
# TWD, JPY, and KRW are zero-decimal; USD and EUR are charged in cents.
STRIPE_SECRET_KEY=
# Checkout charges the NT$9 plan directly. A dashboard Price ID is not applied.
STRIPE_PRICE_ID=
# Set to ecpay to keep checkout at NT$9 and note that the charge is in TWD.
PAYMENT_PROVIDER=stripe

# 綠界 ECPay. production reads the keys below. stage/test ignores them and uses the official test merchant.
# ECPAY_ENV=stage
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# Homepage footer contact (ECPay seller disclosure). Public; safe to expose in the browser.
NEXT_PUBLIC_SUPPORT_EMAIL=support@necterelux.com
NEXT_PUBLIC_SUPPORT_PHONE=09xxxxxxxx

# Google OAuth (NextAuth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
