# Copy this file to .env.local and paste your keys.
# Never commit .env.local.

OPENAI_API_KEY=

# Signed usage cookies (optional; falls back to Stripe or OpenAI key).
USAGE_SECRET=

# Stripe Checkout. The NT$33 plan is converted to USD, JPY, KRW, or EUR from the selected language.
# TWD, JPY, and KRW are zero-decimal; USD and EUR are charged in cents.
STRIPE_SECRET_KEY=
# Optional: existing Stripe Price ID. Used only when the charge stays in TWD.
STRIPE_PRICE_ID=
# Set to ecpay to keep checkout at NT$33 and note that the charge is in TWD.
PAYMENT_PROVIDER=stripe

# Google OAuth (NextAuth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
