# Copy this file to .env.local and paste your keys.
# Never commit .env.local.

OPENAI_API_KEY=

# Signed usage cookies (optional; falls back to Stripe or OpenAI key).
USAGE_SECRET=

# Stripe Checkout for the NT$33 plan (TWD is a zero-decimal currency).
STRIPE_SECRET_KEY=
# Optional: existing Stripe Price ID. If empty, Checkout uses NT$33 price_data.
STRIPE_PRICE_ID=

# Google OAuth (NextAuth.js)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
