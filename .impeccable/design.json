  "narrative": {
    "northStar": "課表整理工作台",
    "overview": "A calm, practical workspace makes the source image and the weekly timetable easy to inspect. Course names, exact times, classrooms, and functional grid lines supply the visual character. The approved Operate direction uses white work surfaces on cool gray, restrained teal actions, and small functional corners.\n\nThe interface supports checking and correcting information. Keep real state, preview state, eligibility, and recovery choices legible. No marketing hero, decorative illustration, or unnecessary animation belongs in this workbench.",
    "keyCharacteristics": [
      "Source and result remain easy to compare.",
      "Quiet surfaces and subdued course colors support reading.",
      "Functional controls, visible focus, and precise time alignment."
    ],
    "rules": [
      {
        "name": "The Quiet Surface Rule",
        "body": "Use neutral work surfaces and reserve teal for functional emphasis.",
        "section": "colors"
      },
      {
        "name": "The Working Hierarchy Rule",
        "body": "Keep the timetable and its controls visually ahead of supporting instructions and footer details.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Use tonal separation and functional lines for the workbench's structure.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep source and result readable together on desktop and stacked in order on smaller screens.",
      "Do use paired subdued course backgrounds and deep text with tabular time labels.",
      "Do preserve real data, explicit sample labeling, keyboard focus, and account-state behavior."
    ],
    "donts": [
      "Don't add a marketing hero, decorative illustrations, or unnecessary animation to the workbench.",
      "Don't use course colors as validation or payment status semantics.",
      "Don't replace precise time and classroom information with decorative summaries."
    ]
  }
}
